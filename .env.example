# ResumeTailor — copy to .env and fill in.
# Comments always go on their OWN line: docker's env_file reads a "# comment" written after an
# empty value as the value itself. Leave optional keys empty to switch the feature off.

# ---- required ----
# Session signing secret. Generate on the server: openssl rand -hex 32 (required in production).
AUTH_SECRET=
# console.anthropic.com → API keys; the account needs credit.
ANTHROPIC_API_KEY=
# The public origin, no trailing slash. Checkout return URLs and payment webhooks are built from it.
NEXT_PUBLIC_BASE_URL=https://your-domain.com
# The admin account. Changing ADMIN_PASSWORD here re-syncs the admin password on the next boot.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=

# ---- payments (enable one or both; with none, pricing shows no buy buttons) ----
# Global card checkout in USD. Webhook: /api/webhooks/stripe, events checkout.session.completed and charge.refunded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mercado Pago: Pix, boleto and card, charged in BRL (offered to every language when Stripe is off).
# Webhook: /api/webhooks/mercadopago, event "Pagamentos".
MP_ACCESS_TOKEN=

# ---- AI voice (the listener speaks with an AI voice, never the browser's) ----
# Preferred: elevenlabs.io (multilingual, natural pt-BR).
ELEVENLABS_API_KEY=
# Optional; empty uses a multilingual default voice.
ELEVENLABS_VOICE_ID=
# Alternative provider: OpenAI TTS (gpt-4o-mini-tts).
OPENAI_API_KEY=
# Disk cache for spoken prompts, in megabytes (least recently used files go first).
TTS_CACHE_MAX_MB=200

# ---- AI models and cost control ----
# Upgrade the kit to claude-opus-5 if the margin allows.
AI_MODEL_KIT=claude-sonnet-5
AI_MODEL_EXTRACT=claude-sonnet-5
# Global kill switch: once the recorded AI spend of the current UTC day reaches this, AI features pause.
AI_DAILY_BUDGET_USD=25
# Free "go deeper" re-tailorings per kit (each is a full generation).
KIT_DEEPEN_MAX=2
# Voice mock-interview sessions allowed per kit.
INTERVIEW_MAX_SESSIONS_PER_KIT=5
# Free "am I a fit?" AI reads per person per rolling day (cache hits are free).
FIT_CHECKS_PER_DAY=5
# Anonymous kit previews allowed per IP address per day (signed-in users have their own cap).
ANON_PREVIEWS_PER_IP_PER_DAY=3
# Free signup credits granted per IP address in 30 days (later signups from that IP start with 0).
SIGNUP_BONUS_PER_IP_30D=2

# ---- company insights (optional; the feature and its copy disappear when empty) ----
TAVILY_API_KEY=

# ---- support channels (optional; each one only renders when set; the contact form always works) ----
SUPPORT_EMAIL=
# Digits only with the country code, e.g. 55 + area code + number.
SUPPORT_WHATSAPP=

# ---- seller identity shown on the legal pages (optional; unset lines are omitted, never invented) ----
LEGAL_NAME=
LEGAL_DOCUMENT=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# ---- demos and e2e only ----
# AI_MOCK=1
