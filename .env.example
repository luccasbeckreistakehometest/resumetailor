# ---- required ----
AUTH_SECRET=change-me-to-a-long-random-string        # openssl rand -hex 32
ANTHROPIC_API_KEY=sk-ant-...                          # console.anthropic.com — needs credit
NEXT_PUBLIC_BASE_URL=https://your-domain.com
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=choose-a-strong-password

# ---- payments (enable one or both) ----
STRIPE_SECRET_KEY=sk_live_...                         # global card checkout (USD)
STRIPE_WEBHOOK_SECRET=whsec_...                       # endpoint: /api/webhooks/stripe, event checkout.session.completed
MP_ACCESS_TOKEN=APP_USR-...                           # Brazil: Pix/boleto/card (BRL); webhook: /api/webhooks/mercadopago

# ---- AI voice (the listener speaks with an AI voice, never the browser's) ----
ELEVENLABS_API_KEY=                                   # preferred: elevenlabs.io → multilingual, natural pt-BR
ELEVENLABS_VOICE_ID=                                  # optional; default is a multilingual voice
# OPENAI_API_KEY=                                     # alternative: OpenAI TTS (gpt-4o-mini-tts)

# ---- optional ----
AI_MODEL_KIT=claude-sonnet-5                          # upgrade to claude-opus-5 for the kit if margin allows
AI_MODEL_EXTRACT=claude-sonnet-5
TAVILY_API_KEY=                                       # company insights; off when empty
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=5511999999999
# AI_MOCK=1                                           # fixtures instead of the API (demos / e2e only)
INTERVIEW_MAX_SESSIONS_PER_KIT=5                      # voice mock-interview sessions allowed per kit
KIT_DEEPEN_MAX=2                                      # free "go deeper" re-tailorings per kit (each is a full generation)
FIT_CHECKS_PER_DAY=5                                  # free "am I a fit?" AI reads per person per rolling day (cache hits are free)
