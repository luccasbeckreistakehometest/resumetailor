# ResumeTailor — copy to .env and fill in.
# Comments always go on their OWN line: docker's env_file reads a "# comment" written after an
# empty value as the value itself. Leave optional keys empty to switch the feature off.

# ---- required ----
# Session signing secret. Generate on the server: openssl rand -hex 32 (required in production).
AUTH_SECRET=
# console.anthropic.com → API keys; the account needs credit.
ANTHROPIC_API_KEY=
# The public origin, no trailing slash. Checkout return URLs and payment webhooks are built from it.
NEXT_PUBLIC_BASE_URL=https://your-domain.com
# The admin account. Changing ADMIN_PASSWORD here re-syncs the admin password on the next boot.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=

# ---- payments (enable one or both; with none, pricing shows no buy buttons) ----
# Global card checkout in USD. Webhook: /api/webhooks/stripe, events checkout.session.completed,
# charge.refunded and charge.dispute.created.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mercado Pago: Pix, boleto and card, charged in BRL (offered to every language when Stripe is off).
# Webhook: /api/webhooks/mercadopago, event "Pagamentos".
MP_ACCESS_TOKEN=

# ---- AI voice (the listener speaks with an AI voice, never the browser's) ----
# Preferred: elevenlabs.io (multilingual, natural pt-BR).
ELEVENLABS_API_KEY=
# Optional; empty uses a multilingual default voice.
ELEVENLABS_VOICE_ID=
# Alternative provider: OpenAI TTS (gpt-4o-mini-tts).
OPENAI_API_KEY=
# Disk cache for spoken prompts, in megabytes (least recently used files go first).
TTS_CACHE_MAX_MB=200

# ---- AI models and cost control ----
# Upgrade the kit to claude-opus-5 if the margin allows.
AI_MODEL_KIT=claude-sonnet-5
AI_MODEL_EXTRACT=claude-sonnet-5
# Global kill switch: once the recorded AI spend of the current UTC day reaches this, AI features pause.
AI_DAILY_BUDGET_USD=25
# The slice of that ceiling visitors without an account may use (empty = a fifth of it; negative = no slice).
AI_ANON_DAILY_BUDGET_USD=
# Free "go deeper" re-tailorings per kit (each is a full generation).
KIT_DEEPEN_MAX=2
# Voice mock-interview sessions allowed per kit.
INTERVIEW_MAX_SESSIONS_PER_KIT=5
# Free "am I a fit?" AI reads per rolling day (cache hits are free): visitors / accounts / paying accounts.
# The job comparator runs one per posting.
FIT_CHECKS_PER_DAY=5
FIT_CHECKS_PER_DAY_USER=10
FIT_CHECKS_PER_DAY_PAID=30
# "Missing numbers" rewrite rounds per kit (one small AI call each).
KIT_QUANTIFY_MAX=1
# International versions (languages) per kit.
KIT_INTL_MAX=2
# AI ratings of pitch-video takes per kit (only the transcript and numbers are sent).
PITCH_FEEDBACK_MAX_PER_KIT=5
# Spoken turns per voice briefing, and new briefings per visitor / per IP per day.
VOICE_MAX_TURNS=8
RL_VOICE_BRIEFINGS_OWNER_DAY=6
RL_VOICE_BRIEFINGS_IP_DAY=20
# Job links read from Greenhouse / Lever / Ashby per visitor per day (the RL_JOB_IMPORT_OWNER_DAY rule).
RL_JOB_IMPORT_OWNER_DAY=30
# First-party analytics: days to keep raw events, and events per visitor per day.
ANALYTICS_RETENTION_DAYS=180
ANALYTICS_EVENTS_PER_VISITOR_DAY=500
# Per-IP guards (visitor cookies can be made up): beacon events per IP per hour, and never-seen
# visitors per IP per day. Raise the second one if many real people share one IP (offices, CGNAT).
RL_ANALYTICS_IP_HOUR=600
RL_ANALYTICS_NEW_VISITOR_IP_DAY=60
# Saved-profile writes per IP per hour.
RL_PROFILE_WRITE_IP_HOUR=30
# Credits each side gets when a referred friend's first purchase settles.
REFERRAL_CREDITS=1
# Anonymous kit previews allowed per IP address per day (signed-in users have their own cap).
ANON_PREVIEWS_PER_IP_PER_DAY=3
# Free signup credits granted per IP address in 30 days (later signups from that IP start with 0).
SIGNUP_BONUS_PER_IP_30D=2

# ---- company insights (optional; the feature and its copy disappear when empty) ----
TAVILY_API_KEY=

# ---- support channels (optional; each one only renders when set; the contact form always works) ----
SUPPORT_EMAIL=
# Digits only with the country code, e.g. 55 + area code + number.
SUPPORT_WHATSAPP=

# ---- seller identity on the legal pages (REQUIRED to sell: a production server offers no checkout
# until all four are set; LEGAL_EMAIL falls back to SUPPORT_EMAIL). Name, CPF/CNPJ, address, e-mail. ----
LEGAL_NAME=
LEGAL_DOCUMENT=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# ---- demos and e2e only ----
# AI_MOCK=1
# JOB_IMPORT_MOCK=1          (job links served from fixtures; needs a non-production server or E2E_TEST_MODE=1)
# ANALYTICS_ALLOW_HEADLESS=1 (count a headless browser as a visitor)
